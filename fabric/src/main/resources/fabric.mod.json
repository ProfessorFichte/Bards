{
  "schemaVersion": 1,
  "id": "bards_rpg",
  "version": "${version}",
  "name": "Bard",
  "description": "Motivate and strengthen the party with awesome songs and ballads!",
  "authors": [
    "Fichte"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/bard-more-rpg-classes",
    "sources": "https://github.com/ProfessorFichte/Bards",
    "issues": "https://github.com/ProfessorFichte/Bards/issues"
  },
  "license": "ARR",
  "icon": "assets/bards_rpg/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bards.fabric.FabricMod"
    ],
    "client": [
      "com.bards.fabric.client.FabricModClient"
    ],
    "fabric-datagen": [
      "com.bards.datagen.BardsDataGenerator"
    ]
  },
  "mixins": [
    "bards_rpg.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_compat_version}",
    "minecraft": ">=${minecraft_compat_version}",
    "java": ">=21",
    "fabric-api": "*",
    "armor_model_api": ">=${armor_model_api_version}",
    "spell_engine": ">=${spell_engine_version}",
    "spell_power": ">=${spell_power_version}",
    "mrpg_lib": ">=${more_rpg_library_version}",
    "structure_pool_api": ">=${structure_pool_api_version}",
    "ranged_weapon_api": ">=${ranged_weapon_api_version}"
  },
  "suggests": {
    "armory_rpgs": "*",
    "arsenal": "*",
    "mrpgc_skill_tree": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/AShKd5XrTu",
        "modmenu.kofi": "https://ko-fi.com/fichteee",
        "modmenu.wiki": "https://github.com/ProfessorFichte/Bards/wiki",
        "modmenu.modrinth": "https://modrinth.com/mod/bard-more-rpg-classes",
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/bard-more-rpg-classes"
      }
    }
  }
}
