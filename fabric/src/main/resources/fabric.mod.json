{
  "schemaVersion": 1,
  "id": "bards_rpg",
  "version": "${version}",
  "name": "Bards (RPG Series Plus)",
  "description": "Motivate and strengthen the party with awesome song's and ballads!",
  "authors": [
    "Fichte"
  ],
  "contact": {
    "sources": "https://github.com/ProfessorFichte"
  },
  "license": "ARR",
  "icon": "assets/bards_rpg/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.bards.fabric.FabricMod"
    ],
    "client": [
      "com.bards.fabric.client.FabricModClient"
    ],
    "fabric-datagen": [
      "com.bards.datagen.BardsDataGenerator"
    ]
  },
  "mixins": [
    "bards_rpg.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_compat_version}",
    "java": ">=21",
    "fabric-api": "*",
    "azurelibarmor": ">=${azure_lib_version}",
    "spell_engine": ">=${spell_engine_version}",
    "spell_power": ">=${spell_power_version}",
    "more_rpg_classes": ">=${more_rpg_library_version}",
    "structure_pool_api": ">=${structure_pool_api_version}",
    "ranged_weapon_api": ">=${ranged_weapon_api_version}"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/AShKd5XrTu"
      }
    }
  }
}
